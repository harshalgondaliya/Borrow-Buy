# ==========================================
# BorrowBuy Platform - Root Environment Config
# ==========================================

# Database Configuration (Local PostgreSQL via Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=borrowbuy_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/borrowbuy_db?schema=public"

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT Authentication
JWT_SECRET="borrowbuy_dev_jwt_secret_key_secure_local_development_2026"
JWT_EXPIRES_IN="7d"

# Driver Abstractions (Pluggable Local vs AWS)
STORAGE_DRIVER=local
NOTIFICATION_DRIVER=local
PAYMENT_DRIVER=simulation
QUEUE_DRIVER=local

# AWS Production Configuration (Mumbai ap-south-1)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_SQS_QUEUE_URL=
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_SNS_TOPIC_ARN=

