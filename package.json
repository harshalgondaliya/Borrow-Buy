{
  "name": "borrowbuy-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BorrowBuy - Product Rental and Management Platform Monorepo",
  "workspaces": [
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace=database",
    "db:seed": "npm run seed --workspace=database",
    "db:studio": "npm run studio --workspace=database"
  },
  "keywords": [
    "rental",
    "marketplace",
    "aws",
    "cloud-computing",
    "typescript",
    "react",
    "express",
    "prisma"
  ],
  "author": "BorrowBuy Team",
  "license": "ISC"
}

